
<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="262" viewBox="0 0 1000 262" font-family="ui-monospace, SFMono-Regular, Menlo, Consolas, monospace">

<style>

@keyframes weave {
  from { stroke-dashoffset: 100 }
  to { stroke-dashoffset: 0 }
}

@keyframes fade {
  from { opacity: 0 }
  to { opacity: 1 }
}

@keyframes glow {
  0%,100% { opacity:.25 }
  50% { opacity:.7 }
}

@keyframes bleed {
  from { opacity:0; transform:translateY(-14px) }
  to { opacity:1; transform:none }
}

@keyframes pulse {
  0%,100% { opacity:1 }
  50% { opacity:.25 }
}

@keyframes ooze {
  0%,100% { transform:translateY(0) }
  50% { transform:translateY(3px) }
}

.s {
  animation:weave 2s ease-out both;
  stroke-dasharray:100;
}

.name {
  animation:fade 1s ease-out 1s both;
}

.halo {
  animation:glow 4s ease-in-out infinite;
}

.rule {
  animation:weave .8s ease-out 1.5s both;
}

.tag {
  animation:fade .8s ease-out 1.8s both;
}

.goo {
  animation:bleed 1s ease-out 2s both, ooze 6s ease-in-out 3s infinite;
}

.dot {
  animation:pulse 1.8s ease-in-out infinite;
}

@media(prefers-reduced-motion:reduce) {
  * { animation:none!important }
}

</style>

<defs>

