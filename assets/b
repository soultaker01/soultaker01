  <linearGradient id="drip" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#101b31"></stop>
    <stop offset=".5" stop-color="#080b12"></stop>
    <stop offset="1" stop-color="#020304"></stop>
